# Names and non-secret defaults only. Mount the token as a runtime secret file.
TIPNEWS_TOKEN_FILE=secrets/telegram_token
TIPNEWS_DATABASE_URL=sqlite+aiosqlite:///data/tipnews.db
TIPNEWS_SOURCES_FILE=config/sources.toml
TIPNEWS_TIMEZONE=Europe/Moscow
TIPNEWS_DIGEST_TIME=07:15
TIPNEWS_WEATHER_REFRESH_TIME=07:10
TIPNEWS_OLLAMA_URL=http://127.0.0.1:11434
TIPNEWS_OLLAMA_MODEL=qwen3:0.6b
TIPNEWS_WEATHER_ENABLED=true
TIPNEWS_ADMIN_IDS=
# Application reads environment variables, not this file implicitly.
# For Docker Compose use an explicit --env-file path (see docs/gemini.md).
TIPNEWS_LLM_PROVIDER=ollama
TIPNEWS_GEMINI_MODEL=gemini-2.5-flash
TIPNEWS_GEMINI_API_KEY=
TIPNEWS_GEMINI_MAX_OUTPUT_TOKENS=512
TIPNEWS_GEMINI_DAILY_REQUEST_LIMIT=100
TIPNEWS_GEMINI_TIMEOUT_SECONDS=45
